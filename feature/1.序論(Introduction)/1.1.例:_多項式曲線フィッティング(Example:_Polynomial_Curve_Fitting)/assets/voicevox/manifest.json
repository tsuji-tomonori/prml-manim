  "scenes": [
    {
      "id": "scene01",
      "title": "この点を生んだ曲線は？",
      "status": "generated",
      "path": "assets/voicevox/scene01.wav",
      "script_sha256": "802dd282f2f178e842a3fee4cea4c40d15829f0e8ad02a070e663ec86ed91ace",
      "wav_sha256": "b80f4bb6565c98e4bc6463063d35bb9c78e67346ee8d9f676a5c39360362bd19",
      "duration": 51.06666666666667,
      "beat_durations": [
        8.666666666666666,
        7.866666666666666,
        9.133333333333333,
        7.666666666666667,
        8.333333333333334,
        9.4
      ],
      "beat_speech_ends": [
        8.298666666666668,
        7.477333333333333,
        8.725333333333333,
        7.296,
        7.925333333333334,
        9.013333333333334
      ],
      "subtitle_cues": [
        {
          "beat_index": 0,
          "text": "ここに十個の点があります。",
          "start": 0.0,
          "end": 1.888
        },
        {
          "beat_index": 0,
          "text": "この点を生んだ曲線は、どんな形でしょう。",
          "start": 1.888,
          "end": 5.045333333333334
        },
        {
          "beat_index": 0,
          "text": "まずは、点だけを見て予想してみてください。",
          "start": 5.045333333333334,
          "end": 8.298666666666668
        },
        {
          "beat_index": 1,
          "text": "横軸のエックスが入力、縦軸のティーが観測した値です。",
          "start": 8.666666666666666,
          "end": 13.093333333333334
        },
        {
          "beat_index": 1,
          "text": "まだ点のない場所では、どんな値になるでしょう。",
          "start": 13.093333333333334,
          "end": 16.144
        },
        {
          "beat_index": 2,
          "text": "この実験では、サインの波にランダムなずれを加えて、点を作りました。",
          "start": 16.533333333333335,
          "end": 21.621333333333332
        },
        {
          "beat_index": 2,
          "text": "緑の線は、答え合わせのためにだけ見せています。",
          "start": 21.621333333333332,
          "end": 25.258666666666667
        },
        {
          "beat_index": 3,
          "text": "学習する側が受け取るのは、青い点だけです。",
          "start": 25.666666666666668,
          "end": 29.08
        },
        {
          "beat_index": 3,
          "text": "背後の波の式も、加えたノイズも教えてもらえません。",
          "start": 29.08,
          "end": 32.962666666666664
        },
        {
          "beat_index": 4,
          "text": "入力から連続的な値を予測する問題を、回帰と呼びます。",
          "start": 33.333333333333336,
          "end": 37.781333333333336
        },
        {
          "beat_index": 4,
          "text": "ここでは、赤い多項式を予想の道具にします。",
          "start": 37.781333333333336,
          "end": 41.25866666666667
        },
        {
          "beat_index": 5,
          "text": "目標は、新しい点でも予測が当たることです。",
          "start": 41.666666666666664,
          "end": 45.24
        },
        {
          "beat_index": 5,
          "text": "この能力を汎化と呼びます。",
          "start": 45.24,
          "end": 47.245333333333335
        },
        {
          "beat_index": 5,
          "text": "そのための曲線を、これから作っていきましょう。",
          "start": 47.245333333333335,
          "end": 50.68
        }
      ]
    },
    {
      "id": "scene02",
      "title": "多項式は、つまみの集まり",
      "status": "generated",
      "path": "assets/voicevox/scene02.wav",
      "script_sha256": "bfa0da4e9375f9aa5a6774a71807f0c911a0674adaeb09e0b97431106dc18d4c",
      "wav_sha256": "8f2e1e10824611ed7cd376cdd6b318c2f09d48a91a8cd8588bc1d70e97265dd9",
      "duration": 67.46666666666667,
      "beat_durations": [
        8.066666666666666,
        8.533333333333333,
        8.0,
        10.733333333333333,
        8.333333333333334,
        8.266666666666667,
        8.8,
        6.733333333333333
      ],
      "beat_speech_ends": [
        7.669333333333333,
        8.149333333333333,
        7.616,
        10.325333333333333,
        7.978666666666666,
        7.8933333333333335,
        8.426666666666666,
        6.368
      ],
      "subtitle_cues": [
        {
          "beat_index": 0,
          "text": "まず、水平な線から始めます。",
          "start": 0.0,
          "end": 2.6346666666666665
        },
        {
          "beat_index": 0,
          "text": "ダブリューゼロは高さのつまみです。",
          "start": 2.6346666666666665,
          "end": 4.874666666666666
        },
        {
          "beat_index": 0,
          "text": "動かすと、線全体が上下します。",
          "start": 4.874666666666666,
          "end": 7.669333333333333
        },
        {
          "beat_index": 1,
          "text": "次は、エックスを掛ける項です。",
          "start": 8.066666666666666,
          "end": 10.477333333333334
        },
        {
          "beat_index": 1,
          "text": "ダブリューイチを動かすと、傾きが変わります。",
          "start": 10.477333333333334,
          "end": 13.72
        },
        {
          "beat_index": 1,
          "text": "二つのつまみで直線が作れます。",
          "start": 13.72,
          "end": 16.216
        },
        {
          "beat_index": 2,
          "text": "エックスの二乗を加えると、曲がり方も変えられます。",
          "start": 16.6,
          "end": 20.28
        },
        {
          "beat_index": 2,
          "text": "色のついた項と、同じ色のつまみを見比べてください。",
          "start": 20.28,
          "end": 24.216
        },
        {
          "beat_index": 3,
          "text": "さらに三乗の項を加えます。",
          "start": 24.6,
          "end": 26.765333333333334
        },
        {
          "beat_index": 3,
          "text": "材料は、一、エックス、二乗、三乗。",
          "start": 26.765333333333334,
          "end": 31.309333333333335
        },
        {
          "beat_index": 3,
          "text": "係数は、その材料をどれだけ混ぜるかを決めます。",
          "start": 31.309333333333335,
          "end": 34.925333333333334
        },
        {
          "beat_index": 4,
          "text": "つまみをいっしょに動かすと、赤い線の形が連続的に変わります。",
          "start": 35.333333333333336,
          "end": 40.101333333333336
        },
        {
          "beat_index": 4,
          "text": "これが、多項式を調整するということです。",
          "start": 40.101333333333336,
          "end": 43.312
        },
        {
          "beat_index": 5,
          "text": "エムは、使う項の最高の次数です。",
          "start": 43.666666666666664,
          "end": 46.589333333333336
        },
        {
          "beat_index": 5,
          "text": "ゼロ番から数えるので、係数のつまみは、エムプラス一本あります。",
          "start": 46.589333333333336,
          "end": 51.56
        },
        {
          "beat_index": 6,
          "text": "三次式でも、三乗の係数をゼロにすれば二次式になります。",
          "start": 51.93333333333333,
          "end": 56.40266666666667
        },
        {
          "beat_index": 6,
          "text": "高い次数のモデルには、低い次数のモデルが含まれます。",
          "start": 56.40266666666667,
          "end": 60.36
        },
        {
          "beat_index": 7,
          "text": "どのつまみの位置がよいのでしょう。",
          "start": 60.733333333333334,
          "end": 62.824
        },
        {
          "beat_index": 7,
          "text": "次は、点からのずれを、目で見て比較できる量に変えます。",
          "start": 62.824,
          "end": 67.10133333333333
        }
      ]
    },
    {
      "id": "scene03",
      "title": "ずれを、面積に変える",
      "status": "generated",
      "path": "assets/voicevox/scene03.wav",
      "script_sha256": "47d2b7a85d4766faf587431df40260c52789ffbc8151603082ec1f4a8d6e3b3f",
      "wav_sha256": "8e2daa9c1234a5adb5bcfaa487161fbe9e4fdd8f915923fd1d1ccb5b2f26bbbd",
      "duration": 79.53333333333333,
      "beat_durations": [
        7.466666666666667,
        7.466666666666667,
        8.6,
        9.533333333333333,
        9.8,
        9.6,
        9.533333333333333,
        9.066666666666666,
        8.466666666666667
      ],
      "beat_speech_ends": [
        7.050666666666666,
        7.1146666666666665,
        8.202666666666667,
        9.12,
        9.397333333333334,
        9.194666666666667,
        9.141333333333334,
        8.672,
        8.064
      ],
      "subtitle_cues": [
        {
          "beat_index": 0,
          "text": "赤い予測から、青い観測を引いた値を残差と呼びます。",
          "start": 0.0,
          "end": 4.010666666666666
        },
        {
          "beat_index": 0,
          "text": "画面の縦線が、そのずれの大きさです。",
          "start": 4.010666666666666,
          "end": 7.050666666666666
        },
        {
          "beat_index": 1,
          "text": "まず二つの残差だけを見ます。",
          "start": 7.466666666666667,
          "end": 9.536
        },
        {
          "beat_index": 1,
          "text": "プラスとマイナスをそのまま足すと、大きなずれがあっても、打ち消し合います。",
          "start": 9.536,
          "end": 14.581333333333333
        },
        {
          "beat_index": 2,
          "text": "二乗するとどうでしょう。",
          "start": 14.933333333333334,
          "end": 16.458666666666666
        },
        {
          "beat_index": 2,
          "text": "プラス一もマイナス一も、二乗すれば一です。",
          "start": 16.458666666666666,
          "end": 19.850666666666665
        },
        {
          "beat_index": 2,
          "text": "ずれの向きが違っても、両方を数えられます。",
          "start": 19.850666666666665,
          "end": 23.136
        },
        {
          "beat_index": 3,
          "text": "それぞれの縦線の長さを、共通の縮尺で正方形の一辺へ移します。",
          "start": 23.533333333333335,
          "end": 28.984
        },
        {
          "beat_index": 3,
          "text": "正方形の面積が、残差の二乗を表します。",
          "start": 28.984,
          "end": 32.653333333333336
        },
        {
          "beat_index": 4,
          "text": "十個の面積を集めて、一本の棒へ移します。",
          "start": 33.06666666666667,
          "end": 36.629333333333335
        },
        {
          "beat_index": 4,
          "text": "この合計の半分を、誤差関数イーと呼びます。",
          "start": 36.629333333333335,
          "end": 40.128
        },
        {
          "beat_index": 4,
          "text": "小さいほど、点によく合います。",
          "start": 40.128,
          "end": 42.464
        },
        {
          "beat_index": 5,
          "text": "曲線を上下に動かすと、正方形と棒もいっしょに変わります。",
          "start": 42.86666666666667,
          "end": 47.50666666666667
        },
        {
          "beat_index": 5,
          "text": "大きなずれほど、面積が急に増えるところに注目してください。",
          "start": 47.50666666666667,
          "end": 52.06133333333333
        },
        {
          "beat_index": 6,
          "text": "反対方向にも動かしてみます。",
          "start": 52.46666666666667,
          "end": 54.792
        },
        {
          "beat_index": 6,
          "text": "符号付きの和だけでは、よい曲線を選べません。",
          "start": 54.792,
          "end": 58.184
        },
        {
          "beat_index": 6,
          "text": "二乗した面積の合計を、小さくしたいのです。",
          "start": 58.184,
          "end": 61.608
        },
        {
          "beat_index": 7,
          "text": "式のシグマは、全部足すという意味です。",
          "start": 62.0,
          "end": 64.83733333333333
        },
        {
          "beat_index": 7,
          "text": "前にある二分の一は、計算を便利にする定数で、谷底の位置を変えません。",
          "start": 64.83733333333333,
          "end": 70.672
        },
        {
          "beat_index": 8,
          "text": "面積を小さくするつまみの位置を探す。",
          "start": 71.06666666666666,
          "end": 73.88266666666667
        },
        {
          "beat_index": 8,
          "text": "それが最小二乗です。",
          "start": 73.88266666666667,
          "end": 75.61066666666666
        },
        {
          "beat_index": 8,
          "text": "この探し方を、次は地形として見てみましょう。",
          "start": 75.61066666666666,
          "end": 79.13066666666667
        }
      ]
    },
    {
      "id": "scene04",
      "title": "二つのつまみで、谷底へ",
      "status": "generated",
      "path": "assets/voicevox/scene04.wav",
      "script_sha256": "5105677f4b6aca7a3bbd7605f4f61795ff08237ccc3dd2204c7f1e4c66ad5281",
      "wav_sha256": "c211fae9d43a52ecb6c92a03bb873e7bb41adcda87d5374912a7a7d4bd6a7673",
      "duration": 56.13333333333333,
      "beat_durations": [
        9.466666666666667,
        10.866666666666667,
        8.0,
        9.933333333333334,
        8.866666666666667,
        9.0
      ],
      "beat_speech_ends": [
        9.066666666666666,
        10.485333333333333,
        7.648,
        9.525333333333334,
        8.512,
        8.629333333333333
      ],
      "subtitle_cues": [
        {
          "beat_index": 0,
          "text": "次数を一に戻します。",
          "start": 0.0,
          "end": 1.6746666666666667
        },
        {
          "beat_index": 0,
          "text": "動かせるのは、高さと傾きの二つです。",
          "start": 1.6746666666666667,
          "end": 4.8
        },
        {
          "beat_index": 0,
          "text": "右の地図では、横が高さ、縦が傾きのつまみです。",
          "start": 4.8,
          "end": 9.066666666666666
        },
        {
          "beat_index": 1,
          "text": "右の点一つが、左の直線一本に対応します。",
          "start": 9.466666666666667,
          "end": 13.392
        },
        {
          "beat_index": 1,
          "text": "等高線は、誤差が同じになる位置を結んだ線です。",
          "start": 13.392,
          "end": 17.24266666666667
        },
        {
          "beat_index": 1,
          "text": "内側ほど、誤差が小さくなります。",
          "start": 17.24266666666667,
          "end": 19.952
        },
        {
          "beat_index": 2,
          "text": "点を谷の内側へ動かすと、左の直線も変わります。",
          "start": 20.333333333333332,
          "end": 24.461333333333332
        },
        {
          "beat_index": 2,
          "text": "点とのずれが減り、誤差の数値も下がっていきます。",
          "start": 24.461333333333332,
          "end": 27.981333333333332
        },
        {
          "beat_index": 3,
          "text": "さらに谷底に近づけます。",
          "start": 28.333333333333332,
          "end": 30.36
        },
        {
          "beat_index": 3,
          "text": "これは、誤差が下がる道筋を見せるための動きです。",
          "start": 30.36,
          "end": 34.050666666666665
        },
        {
          "beat_index": 3,
          "text": "実際の計算では、谷底を直接求められます。",
          "start": 34.050666666666665,
          "end": 37.858666666666664
        },
        {
          "beat_index": 4,
          "text": "谷底に着きました。",
          "start": 38.266666666666666,
          "end": 39.696
        },
        {
          "beat_index": 4,
          "text": "これが、この十点に対する最良の直線です。",
          "start": 39.696,
          "end": 43.22666666666667
        },
        {
          "beat_index": 4,
          "text": "でも、直線では波の形までは表せません。",
          "start": 43.22666666666667,
          "end": 46.778666666666666
        },
        {
          "beat_index": 5,
          "text": "係数を選ぶ問題と、次数を選ぶ問題は別です。",
          "start": 47.13333333333333,
          "end": 50.99466666666667
        },
        {
          "beat_index": 5,
          "text": "次は、つまみの本数を増やして、どこまでよくなるか調べましょう。",
          "start": 50.99466666666667,
          "end": 55.76266666666667
        }
      ]
    },
    {
      "id": "scene05",
      "title": "点を通れば、予測もよくなる？",
      "status": "generated",
      "path": "assets/voicevox/scene05.wav",
      "script_sha256": "2d9094560d303e38ad3e6ab324b6b9cf1699f395639f14868c74bb43530f7ee8",
      "wav_sha256": "46032db596fe18ff4440ecef470fcfb45e781d23781e0d69b7bd6f6f676d1d2b",
      "duration": 105.8,
      "beat_durations": [
        10.4,
        10.333333333333334,
        10.666666666666666,
        7.066666666666666,
        7.533333333333333,
        7.533333333333333,
        8.133333333333333,
        6.4,
        8.466666666666667,
        6.666666666666667,
        12.4,
        10.2
      ],
      "beat_speech_ends": [
        9.984,
        9.952,
        10.282666666666668,
        6.656,
        7.1786666666666665,
        7.125333333333334,
        7.765333333333333,
        6.048,
        8.064,
        6.250666666666667,
        11.989333333333333,
        9.845333333333333
      ],
      "subtitle_cues": [
        {
          "beat_index": 0,
          "text": "左は同じ十点、右は誤差の記録帳です。",
          "start": 0.0,
          "end": 3.6693333333333333
        },
        {
          "beat_index": 0,
          "text": "青が訓練データ、オレンジが独立なテストデータ。",
          "start": 3.6693333333333333,
          "end": 7.189333333333333
        },
        {
          "beat_index": 0,
          "text": "係数を決めるのは、青い点だけです。",
          "start": 7.189333333333333,
          "end": 9.984
        },
        {
          "beat_index": 1,
          "text": "まず水平線です。",
          "start": 10.4,
          "end": 11.861333333333333
        },
        {
          "beat_index": 1,
          "text": "残差を二乗し、個数で割って、平方根を取ります。",
          "start": 11.861333333333333,
          "end": 16.021333333333335
        },
        {
          "beat_index": 1,
          "text": "これが、二乗平均平方根、アールエムエス誤差です。",
          "start": 16.021333333333335,
          "end": 20.352
        },
        {
          "beat_index": 2,
          "text": "次数を一へ動かします。",
          "start": 20.733333333333334,
          "end": 22.493333333333332
        },
        {
          "beat_index": 2,
          "text": "止まったところで残差を数え、右へ一点ずつ記録します。",
          "start": 22.493333333333332,
          "end": 27.090666666666667
        },
        {
          "beat_index": 2,
          "text": "移動中の曲線は、前後の係数を補間しています。",
          "start": 27.090666666666667,
          "end": 31.016
        },
        {
          "beat_index": 3,
          "text": "二次式へ進みます。",
          "start": 31.4,
          "end": 32.89333333333333
        },
        {
          "beat_index": 3,
          "text": "曲げられるようになりましたが、この波を表すには、まだ自由さが足りません。",
          "start": 32.89333333333333,
          "end": 38.056
        },
        {
          "beat_index": 4,
          "text": "三次式では、波の流れをかなり捉えます。",
          "start": 38.46666666666667,
          "end": 41.64533333333333
        },
        {
          "beat_index": 4,
          "text": "訓練データだけでなく、未知の点への誤差も下がりました。",
          "start": 41.64533333333333,
          "end": 45.64533333333333
        },
        {
          "beat_index": 5,
          "text": "四次式にすると、青い誤差はさらに下がります。",
          "start": 46.0,
          "end": 49.498666666666665
        },
        {
          "beat_index": 5,
          "text": "しかし、オレンジも必ず下がるとは限りません。",
          "start": 49.498666666666665,
          "end": 53.12533333333333
        },
        {
          "beat_index": 6,
          "text": "五次式です。",
