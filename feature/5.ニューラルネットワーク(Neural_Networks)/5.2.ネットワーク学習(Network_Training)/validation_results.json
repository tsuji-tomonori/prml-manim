  "sync": [
    {
      "id": "scene01-03-01",
      "display": "黄色い線は、予測と観測のずれです。",
      "action_start": 16.333333333333297,
      "action_end": 23.46666666666663,
      "pcm_onset": 16.423625
    },
    {
      "id": "scene01-03-02",
      "display": "1点だけで決めるなら、今の動きは失敗に見えます。",
