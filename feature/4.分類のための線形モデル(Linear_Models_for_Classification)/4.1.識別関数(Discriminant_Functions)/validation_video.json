      "cues": [
        {
          "id": "scene01-hook-01",
          "display": "白い点は今、橙の仲間です。正しく分けられた橙の点を遠ざけても、答えは同じでしょうか。",
          "start": 0.0,
          "end": 7.477333333333333
        },
        {
          "id": "scene01-hook-02",
          "display": "点を下へ動かすと、境界が傾き、白い点は青に変わりました。なぜでしょう。",
          "start": 7.477333333333333,
          "end": 13.728
        }
      ],
      "actions": [
