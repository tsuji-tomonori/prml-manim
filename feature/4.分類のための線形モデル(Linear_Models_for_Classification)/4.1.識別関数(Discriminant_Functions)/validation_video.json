      ],
      "cues": [
        {
          "id": "scene04-03-01",
          "display": "冒頭の橙の点を、正しく分けられていた側へ遠ざけます。白い点の予想を覚えていますか。",
          "start": 205.46666666666013,
          "end": 212.46399999999346
        },
        {
          "id": "scene04-03-02",
          "display": "点を動かすたびに学習し直すと、境界が傾き、白い点の答えが青に変わります。",
          "start": 212.46399999999346,
          "end": 218.9813333333268
        }
      ],
