          "end": 48.117333333333775
        },
        {
          "id": "scene01-04-02",
          "display": "矢印はいつも境界に垂直で、スコアが増える方向を向きます。",
          "start": 48.117333333333775,
          "end": 52.81066666666711
        }
      ],
      "actions": []
    },
    {
