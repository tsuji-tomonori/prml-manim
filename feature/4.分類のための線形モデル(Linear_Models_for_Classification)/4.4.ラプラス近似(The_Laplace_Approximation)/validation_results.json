  "frames": [
    {
      "id": "scene01-01-01",
      "time": 5.49333333333333,
      "display": "左右で形の違う山があります。この分布を、扱いやすい形で表せるでしょうか。",
      "symbol": false
    },
    {
      "id": "scene01-02-01",
      "time": 13.053333333333306,
      "display": "横軸は未知の量$z$、縦軸はそのありそうさです。高い場所ほど、候補として有力です。",
      "symbol": true
    },
    {
      "id": "scene01-03-01",
      "time": 19.079999999999952,
      "display": "観測を見た後の、未知の量についての分布を、事後分布と呼びます。",
      "symbol": false
    },
    {
      "id": "scene01-04-01",
      "time": 25.373333333333264,
      "display": "ロジスティック回帰では、事前分布と尤度を掛けても、単純なガウス形にはなりません。",
      "symbol": false
    },
    {
      "id": "scene01-05-01",
      "time": 33.92000000000006,
      "display": "$f(z)$を積分した面積が$Z$です。この面積で割ると、全体の確率が一になります。",
      "symbol": true
    },
    {
      "id": "scene01-06-01",
      "time": 41.44000000000038,
      "display": "ところが、多くの変数を持つ分布では、この積分を正確に求めることが難しくなります。",
      "symbol": false
    },
    {
      "id": "scene01-recap-01",
      "time": 46.7066666666673,
      "display": "2.3のガウス分布は、中心と広がりで決まりました。",
      "symbol": false
    },
    {
      "id": "scene01-recap-02",
      "time": 52.73333333333427,
      "display": "今回は元の山の頂上を中心にして、対数の曲がり方から幅を選びます。",
      "symbol": false
    },
    {
      "id": "scene01-07-01",
      "time": 59.86666666666796,
      "display": "そこで山の頂上に注目します。位置と曲がり具合から、釣り鐘形のガウス分布を作ります。",
      "symbol": false
    },
    {
      "id": "scene01-08-01",
      "time": 67.14666666666793,
      "display": "これがラプラス近似です。まずは一変数で、どの情報を使い、何を捨てるかを見ましょう。",
      "symbol": false
    },
    {
      "id": "scene01-recap-01-sync-0.1",
      "time": 43.34666666666714,
      "display": "2.3のガウス分布は、中心と広がりで決まりました。",
      "symbol": false
    },
    {
      "id": "scene01-recap-01-sync-0.5",
      "time": 45.266666666667234,
      "display": "2.3のガウス分布は、中心と広がりで決まりました。",
      "symbol": false
    },
    {
      "id": "scene01-recap-02-sync-0.1",
      "time": 48.30000000000072,
      "display": "今回は元の山の頂上を中心にして、対数の曲がり方から幅を選びます。",
      "symbol": false
    },
    {
      "id": "scene01-recap-02-sync-0.5",
      "time": 50.83333333333418,
      "display": "今回は元の山の頂上を中心にして、対数の曲がり方から幅を選びます。",
      "symbol": false
    },
    {
      "id": "scene01-card-before",
      "time": 42.716666666667116,
      "display": "",
      "symbol": false
    },
    {
      "id": "scene01-card-after",
      "time": 54.150000000001,
      "display": "",
      "symbol": false
    },
    {
      "id": "scene02-01-01",
      "time": 74.78666666666754,
      "display": "頂上の位置を$z_0$と書きます。分布が局所的に最大になる位置で、モードとも呼びます。",
      "symbol": true
    },
    {
      "id": "scene02-02-01",
      "time": 82.57333333333376,
      "display": "曲線の上を点が進むと、接線が水平になります。滑らかな頂上では、微分がゼロです。",
      "symbol": false
    },
    {
      "id": "scene02-03-01",
      "time": 90.79999999999997,
      "display": "山全体を正の定数倍しても、頂上の横の位置は動きません。正規化の面積を知らずに探せます。",
      "symbol": false
    },
    {
      "id": "scene02-04-01",
      "time": 98.43999999999953,
      "display": "ここで縦軸を対数に変えます。対数は大小関係を保つので、頂上の位置は同じです。",
      "symbol": false
    },
    {
      "id": "scene02-05-01",
      "time": 106.70666666666573,
      "display": "対数の山を、頂上のすぐ近くで拡大して考えます。位置ごとの変化を、低い次数の式で表します。",
      "symbol": false
    },
    {
      "id": "scene02-06-01",
      "time": 114.2666666666653,
      "display": "高さ、傾き、曲がり具合。この三つを合わせるのが、二次までのテイラー近似です。",
      "symbol": false
    },
    {
      "id": "scene02-07-01",
      "time": 121.65333333333155,
      "display": "頂上では傾きがゼロなので、一次の項が消えます。残るのは、定数と二次の項です。",
      "symbol": false
    },
    {
      "id": "scene02-08-01",
      "time": 128.9999999999978,
      "display": "曲がり具合は、対数の二階微分にマイナスを付けた$A$です。下向きの山なら正になります。",
      "symbol": true
    },
    {
      "id": "scene03-01-01",
      "time": 137.07999999999734,
      "display": "対数の符号を反転すると、山は谷になります。高さの基準を引いて、谷底をゼロにそろえます。",
      "symbol": false
    },
    {
      "id": "scene03-02-01",
      "time": 145.0799999999969,
      "display": "谷底に、同じ曲がり具合の放物線を重ねます。近い場所ほど、二つの曲線が重なります。",
      "symbol": false
    },
    {
      "id": "scene03-03-01",
      "time": 152.8533333333298,
      "display": "$A$を大きくすると、谷の両側が急になります。同じ高さまで登るための横幅が狭まります。",
      "symbol": true
    },
    {
      "id": "scene03-04-01",
      "time": 160.799999999996,
      "display": "逆に曲率を小さくすると、谷は緩やかになります。頂上から離れても、ありそうさが残ります。",
      "symbol": false
    },
    {
      "id": "scene03-05-01",
      "time": 169.2799999999955,
      "display": "この二次式に指数関数を使い、もとの山の形へ戻します。二乗の指数から、ガウス形が現れます。",
      "symbol": false
    },
    {
      "id": "scene03-06-01",
      "time": 176.65333333332845,
      "display": "曲率を再び大きくすると、ガウス分布が細くなります。これが精度と呼ばれる理由です。",
      "symbol": false
    },
    {
      "id": "scene03-07-01",
      "time": 184.9466666666613,
      "display": "分散は$A^{-1}$、標準偏差は$1/\\sqrt{A}$です。分散は広がりを二乗の単位で表します。",
      "symbol": true
    },
    {
      "id": "scene03-08-01",
      "time": 192.6399999999942,
      "display": "曲率がゼロならこの式で幅を決められず、負なら山になりません。正の曲率が必要です。",
      "symbol": false
    },
    {
      "id": "scene04-01-01",
      "time": 200.53333333332708,
      "display": "いまは、元の関数と、その局所的なガウス形を重ねています。頂上の位置と高さは一致します。",
      "symbol": false
    },
    {
      "id": "scene04-02-01",
      "time": 208.05333333332666,
      "display": "二つの曲線の下を塗ってみます。頂上でよく似ていても、裾が違うので面積は異なります。",
      "symbol": false
    },
    {
      "id": "scene04-03-01",
      "time": 215.66666666665955,
      "display": "それぞれを、自分自身の面積で割ります。どちらも全体の確率が一になるようにする操作です。",
      "symbol": false
    },
    {
      "id": "scene04-04-01",
      "time": 223.86666666665909,
      "display": "正規化した後は、頂上の高さがずれます。山頂での局所近似と、密度の高さの一致は別です。",
      "symbol": false
    },
    {
      "id": "scene04-05-01",
      "time": 231.29333333332534,
      "display": "近似密度$q(z)$は、中心がモード、分散が曲率の逆数のガウス分布です。",
      "symbol": true
    },
    {
      "id": "scene04-06-01",
      "time": 239.13333333332488,
      "display": "右の裾へ目を移すと、元の分布との違いが見えます。全体の誤差を最小にした近似ではありません。",
      "symbol": false
    },
    {
      "id": "scene04-07-01",
      "time": 247.13333333332443,
      "display": "左右非対称な分布では、元の分布の平均とモードも違います。ガウスの中心にはモードを使います。",
      "symbol": false
    },
    {
      "id": "scene04-08-01",
      "time": 256.0933333333239,
      "display": "必要な手順は二つです。モードを探し、そこで対数の曲率を計算する。未知の正規化定数は不要です。",
      "symbol": false
    },
    {
      "id": "scene05-01-01",
      "time": 263.8533333333235,
      "display": "未知の量が二つなら、山を上から見てみましょう。同じ高さを結んだ線が、楕円になります。",
      "symbol": false
    },
    {
      "id": "scene05-02-01",
      "time": 271.9999999999897,
      "display": "一方向だけ曲率を大きくすると、楕円はその方向だけ縮みます。方向ごとに不確かさが違います。",
      "symbol": false
    },
    {
      "id": "scene05-03-01",
      "time": 280.5999999999892,
      "display": "楕円を回すと、狭い方向も一緒に回ります。横と縦を別々に扱うだけでは、この向きを表せません。",
      "symbol": false
    },
    {
      "id": "scene05-04-01",
      "time": 288.9466666666554,
      "display": "二階微分を並べたものがヘッセ行列です。対数のヘッセ行列にマイナスを付け、精度行列とします。",
      "symbol": false
    },
    {
      "id": "scene05-aid-01",
      "time": 295.2399999999884,
      "display": "二階微分は、傾きの変わりやすさです。横方向の傾きを見ます。",
      "symbol": false
    },
    {
      "id": "scene05-aid-02",
      "time": 299.9733333333215,
      "display": "縦の位置を変えると、横方向の傾きも変わります。",
      "symbol": false
    },
    {
      "id": "scene05-aid-03",
      "time": 304.3333333333212,
      "display": "この結びつきを、ヘッセ行列の対角以外へ入れます。",
      "symbol": false
    },
    {
      "id": "scene05-05-01",
      "time": 311.8666666666541,
      "display": "楕円の主な二方向では、曲率が固有値になります。固有値は、その方向にどれだけ曲がるかを表します。",
      "symbol": false
    },
    {
      "id": "scene05-06-01",
      "time": 320.5733333333203,
      "display": "共分散行列は$A^{-1}$です。各方向の曲率を逆数にすることで、広がりと向きをまとめます。",
      "symbol": true
    },
    {
      "id": "scene05-07-01",
      "time": 329.5333333333198,
      "display": "どの方向にも正の曲率があることを、正定値といいます。平らな方向や、鞍点では条件を満たしません。",
      "symbol": false
    },
    {
      "id": "scene05-08-01",
      "time": 338.1599999999859,
      "display": "滑らかな極大点でも、二階微分がゼロになることはあります。モードを見つけた後に、曲率も確認します。",
      "symbol": false
    },
    {
      "id": "scene05-aid-01-sync-0.1",
      "time": 291.17999999998864,
      "display": "二階微分は、傾きの変わりやすさです。横方向の傾きを見ます。",
      "symbol": false
    },
    {
      "id": "scene05-aid-01-sync-0.5",
      "time": 293.4999999999885,
      "display": "二階微分は、傾きの変わりやすさです。横方向の傾きを見ます。",
      "symbol": false
    },
    {
      "id": "scene05-aid-02-sync-0.1",
      "time": 296.846666666655,
      "display": "縦の位置を変えると、横方向の傾きも変わります。",
      "symbol": false
    },
    {
      "id": "scene05-aid-02-sync-0.5",
      "time": 298.6333333333215,
      "display": "縦の位置を変えると、横方向の傾きも変わります。",
      "symbol": false
    },
    {
      "id": "scene05-aid-03-sync-0.1",
      "time": 301.299999999988,
      "display": "この結びつきを、ヘッセ行列の対角以外へ入れます。",
      "symbol": false
    },
    {
      "id": "scene05-aid-03-sync-0.5",
      "time": 303.03333333332125,
      "display": "この結びつきを、ヘッセ行列の対角以外へ入れます。",
      "symbol": false
    },
    {
      "id": "scene05-card-before",
      "time": 290.4499999999887,
      "display": "",
      "symbol": false
    },
    {
      "id": "scene05-card-after",
      "time": 305.3499999999878,
      "display": "",
      "symbol": false
    },
    {
      "id": "scene06-01-01",
      "time": 346.4266666666521,
      "display": "今度は、近似した山の面積を求めましょう。確率密度にする前の、正規化されていない関数です。",
      "symbol": false
    },
    {
      "id": "scene06-02-01",
      "time": 354.679999999985,
      "display": "積分は細い短冊の面積を足す操作です。ガウス形なら、短冊を無限に細くした答えが分かります。",
      "symbol": false
    },
    {
      "id": "scene06-03-01",
      "time": 363.42666666665116,
      "display": "頂上の高さを保ち、山を細くしてみます。面積は小さくなります。高さだけでは積分は決まりません。",
      "symbol": false
    },
    {
      "id": "scene06-04-01",
      "time": 371.49333333331737,
      "display": "次に少し低く、ずっと広い山へ変えます。高さが減っても、こちらの面積は大きくなりました。",
      "symbol": false
    },
    {
      "id": "scene06-05-01",
      "time": 380.4266666666502,
      "display": "一変数の面積は、頂上の高さに$\\sqrt{2\\pi/A}$を掛けたものです。幅の分が掛かっています。",
      "symbol": true
    },
    {
      "id": "scene06-06-01",
      "time": 388.8266666666497,
      "display": "多変数では、各方向の幅を掛け合わせます。行列式は、各方向の曲率の積に当たります。",
      "symbol": false
    },
    {
      "id": "scene06-aid-01",
      "time": 395.533333333316,
      "display": "二方向の曲率が $4$ と $1$ なら、標準偏差は $1/2$ と $1$ です。",
      "symbol": true
    },
    {
      "id": "scene06-aid-02",
      "time": 403.30666666664894,
      "display": "幅の積は $1/2$。行列式の平方根の逆数で、この面積倍率が求まります。",
      "symbol": true
    },
    {
      "id": "scene06-07-01",
      "time": 411.4399999999818,
      "display": "その結果、正規化定数は、頂上の高さと、精度行列から決まる体積の積で近似できます。",
      "symbol": false
    },
    {
      "id": "scene06-08-01",
      "time": 419.41333333331465,
      "display": "ここでも裾や別の山の寄与は近似の外です。局所的な形で、全体の積分を見積もっています。",
      "symbol": false
    },
    {
      "id": "scene06-aid-01-sync-0.1",
      "time": 391.09999999998297,
      "display": "二方向の曲率が $4$ と $1$ なら、標準偏差は $1/2$ と $1$ です。",
